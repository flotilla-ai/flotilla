#!/usr/bin/env node
import { spawn } from 'node:child_process';
import { readFileSync } from 'node:fs';

const args = process.argv.slice(2);
const flag = (name) => {
  const at = args.indexOf(name);
  return at >= 0 ? args[at + 1] : null;
};
if (args.includes('--probe')) {
  console.log('fake-agent 0.0.0');
  process.exit(0);
}
if (args.includes('--spawn-child')) spawn(process.execPath, ['-e', 'process.on("SIGINT",()=>{});process.on("SIGTERM",()=>{});setInterval(()=>{},1000)'], { stdio: 'ignore' });
const usageUsd = flag('--usage-usd');
const usageAtEnd = args.includes('--usage-at-end');
const usageMicro = usageUsd === null ? null : Math.round(Number(usageUsd) * 1e6);
const mcpPath = flag('--mcp-config');
let mcp = null;
if (mcpPath) mcp = JSON.parse(readFileSync(mcpPath, 'utf8'));
const emit = (row) => console.log(JSON.stringify(row));
const fixture = args.find((a) => a.endsWith('.jsonl'));
if (fixture) {
  const rows = readFileSync(fixture, 'utf8').split('\n').filter(Boolean).map((line) => JSON.parse(line));
  for (const row of rows) {
    if (row.mcp && mcp?.url) {
      await fetch(mcp.url, {
        method: 'POST',
        headers: { 'content-type': 'application/json', ...(mcp.token ? { authorization: `Bearer ${mcp.token}` } : {}) },
        body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: row.mcp })
      }).catch(() => {});
      continue;
    }
    if (row.sleepMs) await new Promise((r) => setTimeout(r, row.sleepMs));
    delete row.sleepMs;
    emit(row);
    if (usageMicro !== null && !usageAtEnd && row.t !== 'usage') emit({ t: 'usage', usdMicro: usageMicro, cumulative: false });
  }
  if (usageMicro !== null && usageAtEnd) emit({ t: 'usage', usdMicro: usageMicro, cumulative: true });
}
if (args.includes('--hang')) setInterval(() => {}, 1000);
