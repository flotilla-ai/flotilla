{
  "name": "@flotilla/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": {
      "types": "./src/types.ts",
      "development": "./src/types.ts",
      "import": "./dist/types.js"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "development": "./src/schemas.ts",
      "import": "./dist/schemas.js"
    },
    "./kernel/*": {
      "types": "./src/kernel/*.ts",
      "development": "./src/kernel/*.ts",
      "import": "./dist/kernel/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint src"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "oxlint": "^1.0.0"
  }
}
